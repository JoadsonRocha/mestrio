# ==========================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (MESTRIO)
# ==========================================

# 1. Supabase (Obrigatório no Frontend e Backend)
# Encontre no Dashboard do Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# 2. Supabase Service Role Key (Apenas no Servidor/Backend - NUNCA expor no Frontend)
# Usado para tarefas administrativas e expiração automática de anúncios.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# 3. Groq API Key (Obrigatório no Servidor para funções de IA)
# Obtenha uma chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# 4. Segredo do Cron (Expiração de Anúncios)
# Chave secreta usada para autenticar chamadas ao endpoint /api/expire-ads
CRON_SECRET=seu_segredo_cron_super_seguro

# 5. Configurações de Origem e Porta (Servidor Express / Railway)
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://seu-dominio.up.railway.app
