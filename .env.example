# ==========================================
# MESTRIO - VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# ==========================================

# URL e chaves públicas do Supabase (expostas para o cliente)
VITE_SUPABASE_URL=https://kznwivlulavmtaiqleqe.supabase.co
VITE_SUPABASE_ANON_KEY=sua_supabase_anon_key

# Chave privada do Supabase (USO EXCLUSIVO DO SERVIDOR - NUNCA EXPOR NO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=sua_supabase_service_role_key

# Chave da API Groq para geração de descrições e estimador inteligente com IA
GROQ_API_KEY=gsk_sua_groq_api_key

# Chave secreta para acionar endpoints de automação (ex: /api/expire-ads)
CRON_SECRET=uma_chave_secreta_longa_e_segura

# Origens permitidas para requisições CORS (separadas por vírgula em produção)
# Exemplo: https://mestrio.com.br,https://mestrio-production.up.railway.app
ALLOWED_ORIGINS=

# Porta do servidor (padrão 3000 ou injetada pelo Railway/PaaS)
PORT=3000