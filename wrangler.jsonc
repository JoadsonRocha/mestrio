{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mestrio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build:pages"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  }
}
