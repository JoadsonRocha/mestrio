{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mestrio",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build:pages"
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
